{
  "name": "digivice-watchface",
  "author": "crims0n",
  "version": "1.0.0",
  "keywords": ["pebble-app", "digivice", "digimon", "tamagotchi"],
  "private": true,
  "dependencies": {},
  "pebble": {
    "displayName": "Digivice Watchface",
    "uuid": "ae0d488f-9a20-4d88-abec-154cd6e6c29b",
    "sdkVersion": "3",
    "enableMultiJS": false,
    "targetPlatforms": [
      "aplite",
      "basalt",
      "chalk",
      "diorite",
      "emery"
    ],
    "watchapp": {
      "watchface": true
    },
    "messageKeys": [
      "dummy"
    ],
    "resources": {
      "media": [
        {
          "characterRegex": "[0-9:A-Za-z ]",
          "type": "font",
          "name": "FONT_PIXEL_DIGIVOLVE_48",
          "file": "fonts/pixel-digivolve.ttf"
        },
        {
          "characterRegex": "[0-9:A-Za-z ]",
          "type": "font",
          "name": "FONT_PIXEL_DIGIVOLVE_24",
          "file": "fonts/pixel-digivolve.ttf"
        },
        {
          "characterRegex": "[0-9:A-Za-z ]",
          "type": "font",
          "name": "FONT_PIXEL_DIGIVOLVE_16",
          "file": "fonts/pixel-digivolve.ttf"
        },
        {
          "type": "bitmap",
          "name": "ARROW_DARK",
          "file": "images/arrow-dark.png"
        },
        {
          "type": "bitmap",
          "name": "ARROW_FILLED_DARK",
          "file": "images/arrow-filled-dark.png"
        }
      ]
    }
