{
  "name": "digivice-watchface",
  "author": "crims0n",
  "version": "1.0.0",
  "description": "Retro digital watchface inspired by the classic Digimon Digivice virtual pet.",
  "keywords": [
    "pebble-app",
    "pebble-watchface",
    "digivice",
    "digimon",
    "vpet",
    "retro"
  ],
  "license": "MIT",
  "dependencies": {},
  "pebble": {
    "displayName": "Digivice Watchface",
    "uuid": "ae0d488f-9a20-4d88-abec-154cd6e6c29b",
    "sdkVersion": "3",
    "enableMultiJS": false,
    "targetPlatforms": [
      "aplite",
      "basalt",
      "chalk",
      "diorite",
      "emery"
    ],
    "watchapp": {
      "watchface": true
    },
    "resources": {
      "media": [
        {
          "characterRegex": "[0-9:A-Za-z ]",
          "type": "font",
          "name": "FONT_PIXEL_DIGIVOLVE_48",
          "file": "fonts/pixel-digivolve.ttf"
        },
        {
          "characterRegex": "[0-9:A-Za-z ]",
          "type": "font",
          "name": "FONT_PIXEL_DIGIVOLVE_24",
          "file": "fonts/pixel-digivolve.ttf"
        },
        {
          "characterRegex": "[0-9:A-Za-z %]",
          "type": "font",
          "name": "FONT_PIXEL_DIGIVOLVE_16",
          "file": "fonts/pixel-digivolve.ttf"
        }
      ]
    }
  }
}
